{
  "name": "@irudd/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node --import ../../packages/document/test/support/register.ts scripts/build.ts",
    "start": "node --import ../../packages/document/test/support/register.ts scripts/build.ts && node --import ../../packages/document/test/support/register.ts scripts/launch.ts",
    "launch": "node --import ../../packages/document/test/support/register.ts scripts/launch.ts",
    "qa": "node --import ../../packages/document/test/support/register.ts scripts/qa.ts",
    "qa:review": "node --import ../../packages/document/test/support/register.ts scripts/qa-review.ts",
    "qa:proposal-parity": "node --import ../../packages/document/test/support/register.ts scripts/qa-proposal-parity.ts",
    "qa:art": "node --import ../../packages/document/test/support/register.ts scripts/qa-art.ts",
    "qa:shape-parity": "node --import ../../packages/document/test/support/register.ts scripts/qa-shape-parity.ts",
    "qa:style-parity": "node --import ../../packages/document/test/support/register.ts scripts/qa-shape-parity.ts phase9-3",
    "qa:field-parity": "node --import ../../packages/document/test/support/register.ts scripts/qa-shape-parity.ts phase9-2",
    "qa:reference-parity": "node --import ../../packages/document/test/support/register.ts scripts/qa-reference-parity.ts",
    "qa:trace-parity": "node --import ../../packages/document/test/support/register.ts scripts/qa-trace-parity.ts",
    "qa:motion-parity": "node --import ../../packages/document/test/support/register.ts scripts/qa-motion-parity.ts",
    "qa:portraits": "node --import ../../packages/document/test/support/register.ts scripts/qa-portraits.ts",
    "qa:player": "node --import ../../packages/document/test/support/register.ts scripts/qa-player.ts",
    "qa:character": "node --import ../../packages/document/test/support/register.ts scripts/qa-character.ts",
    "qa:adult": "node --import ../../packages/document/test/support/register.ts scripts/qa-adult.ts",
    "test": "node --import ../../packages/document/test/support/register.ts --test \"qa/{update,human,art}/*.test.ts\"",
    "test:recovery": "node --import ../../packages/document/test/support/register.ts --test \"qa/recovery/*.test.ts\"",
    "package": "node --import ../../packages/document/test/support/register.ts scripts/package.ts",
    "rehearse": "node --import ../../packages/document/test/support/register.ts scripts/rehearse.ts",
    "typecheck": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && tsc -p tsconfig.renderer.json && tsc -p scripts/tsconfig.json && tsc -p qa/tsconfig.json"
  },
  "dependencies": {
    "@irudd/character": "workspace:*",
    "@irudd/document": "workspace:*",
    "@irudd/player": "workspace:*",
    "@irudd/workshop": "workspace:*",
    "effect": "catalog:",
    "electron": "catalog:",
    "three": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "@types/three": "catalog:",
    "vite-plus": "catalog:"
  }
}
